APP_NAME="AVA VPN"
APP_BRAND_NAME=AVA
APP_BRAND_SUFFIX=VPN
TELEGRAM_SUPPORT_URL=https://t.me/avavpn_ru
TELEGRAM_CHANNEL_URL=https://t.me/avavpn_ru
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Дополнительные запрещённые домены почты (одноразовые), через запятую. Базовый список — в config/disposable_email.php
# BLOCKED_EMAIL_DOMAINS=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@avavpn.ru"
MAIL_FROM_NAME="AVA VPN Support"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Узлы подписки (модель «одна подписка для всех») =====
# ВАЖНО: значения ОБЯЗАТЕЛЬНО в двойных кавычках — иначе dotenv обрежет всё после '#'
# (в URI '#Имя' — это метка узла в Happ). Без метки узлы в подписке будут «N/A».
# Метка #… в конце URI перезаписывается подписью из App\Support\SharedVpnAccess.
#
# Отдаются клиентам в /sub: SHARED_HY2_URI (Wi-Fi) и SHARED_CDN_URI (обход блокировок).
SHARED_HY2_URI="vless://<uuid>@<host>:443?type=tcp&security=reality&sni=<sni>&fp=chrome&pbk=<public-key>&sid=<short-id>&spx=%2F&flow=xtls-rprx-vision#Label"
SHARED_CDN_URI="vless://<uuid>@<cdn-host>:443?encryption=none&security=tls&sni=<sni>&host=<cdn-host>&type=xhttp&path=%2F...%2F&mode=packet-up#Label"
# Необязательный узел (в подписке /sub сейчас не отдаётся):
# SHARED_VLESS_URI="vless://<uuid>@<host>:443?security=reality&...#Label"

# Админка (/admin) — без этого вход заблокирован
ADMIN_LOGIN=
ADMIN_PASSWORD=

# YooKassa payment
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=  # опционально: свой URL/путь возврата; иначе /cabinet

# API для Telegram-бота и внешних клиентов (заголовок X-Api-Token или Bearer)
API_TOKEN=

# Telegram Bot — для push-уведомлений (оплата получена) из webhook'а YooKassa.
# TELEGRAM_BOT_TOKEN получается у @BotFather. TELEGRAM_BOT_USERNAME (без @) —
# используется как return_url YooKassa, чтобы юзер после оплаты возвращался в чат.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Чат (или группа) куда бот шлёт уведомления о тикетах поддержки.
# Бот должен быть участником чата. Если пусто — пуши не отправляются.
SUPPORT_ADMIN_TELEGRAM_CHAT_ID=

# Подписи узлов Happ (опционально)
HAPP_BRAND=AVA

# Happ routing: RU напрямую, заблокированное через VPN (split + lite geo).
# Lite geofiles (~500 KB) на /geo/*.dat — deploy/update-geo-files.sh
HAPP_ROUTING_MODE=split
HAPP_ROUTING_ENABLED=true
HAPP_ROUTING_NAME="AVA Split RU"
HAPP_ROUTING_LAST_UPDATED=1784060400
HAPP_SUBSCRIPTION_ANNOUNCE="Обновите подписку — исправлен роутинг: RU напрямую, заблокированное через VPN"
HAPP_SUBSCRIPTION_PIN=true
HAPP_GEO_USE_CHUNK_FILES=false
HAPP_GEO_USE_BUILTIN=false
# HAPP_GEOIP_URL=https://avavpn.ru/geo/geoip.dat
# HAPP_GEOSITE_URL=https://avavpn.ru/geo/geosite.dat
# Анонс при истёкшей подписке (иначе — дефолтный текст в config/happ_routing.php)
# HAPP_EXPIRED_ANNOUNCE="Подписка истекла. Продлите тариф на avavpn.ru"

# ===== Триал =====
# Срок (часы) и soft-лимит трафика (ГБ, информационно — не блочит).
TRIAL_DURATION_HOURS=3
# 0 = без лимита трафика на триале (ограничение только по времени)
TRIAL_SOFT_QUOTA_GB=0

# Если в тарифе traffic_gb=0, в subscription-userinfo показывается этот объём (ГБ). 0 = безлимит.
# DEFAULT_RETAIL_TRAFFIC_GB=100

# IndexNow — мгновенная отправка URL в поисковики (Яндекс, Bing, Naver).
# Ключ должен совпадать с именем файла, отдаваемого по /<key>.txt.
# Если оставить пустым, ключ генерируется автоматически из APP_KEY.
INDEXNOW_KEY=
